{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "業務画面(Python が返す画面)から呼んでよいもの。印刷の窓を開く・閉じる・ファイルに保存する だけ",
  "windows": ["main", "print-*"],
  "remote": {
    "urls": ["http://app.localhost/*", "app://localhost/*"]
  },
  "permissions": ["core:default"]
}
